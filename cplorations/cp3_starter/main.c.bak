#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define MAX_LINE_LENGTH  200

/* Goal of program: read a file and write a new file with line numbers
	argc is the name of the program (this one)
	argv[] is the name of the file being read
*/

int main(int argc, const char *argv[]) {
	if (argc != 2) {
		printf("Please select a file: %s [filename]\n", argv[0]);
		exit(EXIT_FAILURE);					//ensure correct no. of args
	}
	FILE *fin = fopen (argv[1], "r" ); 		//read input file
	if (argv[1] == NULL) {
		perror("Can't open the file!");		//error output stream
		exit(EXIT_FAILURE);
	}
	char out_file[256];						//create filename variable
	strcpy (out_file, argv[1]);				//can't get filename in previous line for some dumb reason
	strcat (out_file, ".echo");				
	FILE *fout = fopen (out_file, "w+"); 	//w+ = writable
	printf ("opened fin OK\n");
	
	
	
	/* 5: reading in the file */
	char line[MAX_LINE_LENGTH] = {0};		//variable for line contents
	unsigned int line_num = 0;				//variable for line number, unsigned because always positive
	
	while (fgets(line, sizeof(line), fin)) {
		line_num++;									// increment line no. variable
		printf ("[%04d] %s", line_num, line);		// print line no. in brackets + text
		fprintf (fout, "%s", line);					// print the line to output file (fprintf)
	}
	
	fclose (fin);		// close file pointers
	fclose (fout);
	
	return 1;
}
