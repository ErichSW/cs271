// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    
    // process X side
    Mux16(a=x, b=false, sel=zx, out=zeroedX); // create zero'd out X based on zx
    Not16(in=zeroedX, out=notX);              // create temp not X value 
    Mux16(a=zeroedX, b=notX, 
        sel=nx, out=processedX); // choose based on nx
 
    // process Y side
    Mux16(a=y, b=false, sel=zy, out=zeroedY); // create zero'd out Y based on zy
    Not16(in=zeroedY, out=notY);              // create temp not Y value
    Mux16(a=zeroedY, b=notY, 
        sel=ny, out=processedY); // choose based on ny

    // process Add or AND operation (if f is 0, AND; if f is 1, Add)
    And16(a=processedX, b=processedY, out=andXY);   // create AND'd value
    Add16(a=processedX, b=processedY, out=addXY);   // create added value
    Mux16(a=andXY, b=addXY, sel=f, out=combinedXY); // choose based on f

    // process final bitflip (not a 2's complement)
    Not16(in=combinedXY, out=bitflipXY);            // create bitflip value
    Mux16(a=combinedXY, b=bitflipXY, sel=no, out=out, // choose based on no
        out[15]=ng, // value is negative if leftmost digit is 1
        out[0..7]=outLeft, out[8..15]=outRight);    // create temp pins for mass OR
    
    // process zr with mass OR ops
    Or8Way(in=outLeft, out=zrLeft);
    Or8Way(in=outRight, out=zrRight);
    Or(a=zrLeft, b=zrRight , out=zrFalse); // result is inverted
    Not(in=zrFalse, out=zr);

}